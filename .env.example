# Kanonische Basis-URL der Seite, ohne abschließenden Slash.
# Nicht gesetzt = https://stimme-der-medinastudenten.vercel.app
# Sobald die eigene Domain in Vercel angebunden ist, hier eintragen –
# davon hängen Canonicals, Sitemap, robots.txt und Open Graph ab.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 Measurement-ID der EIGENEN Property (Format: G-XXXXXXXXXX).
# Ist sie nicht gesetzt, wird kein Analytics geladen und kein Cookie-Banner
# angezeigt – die Seite kommt dann ohne einwilligungspflichtige Cookies aus.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-5H0KZ4V7QH

# Google Sheets – Speicherung der Kontaktanfragen (Pflicht für /api/leads)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Kompletter private_key inkl. -----BEGIN PRIVATE KEY----- ; Zeilenumbrüche als \n
GOOGLE_PRIVATE_KEY=

# Name des Tabellenblatts. Ohne Angabe wird "Sheet1" versucht,
# bei Fehlschlag automatisch das erste Blatt der Tabelle (z. B. "Tabelle1").
GOOGLE_SHEET_TAB_NAME_CONTACT=

# Resend – optionale E-Mail-Benachrichtigung bei neuer Anfrage.
# Ohne RESEND_API_KEY wird die Anfrage nur ins Sheet geschrieben.
RESEND_API_KEY=
RESEND_FROM="Stimme der Medinastudenten <onboarding@resend.dev>"
RESEND_TO=kontakt@stimme-medinastudenten.de
